
<section class="management-page order-management-page">

    <div class="section-heading">
        <p class="eyebrow">CHOCOFIXCO BACKEND</p>
        <h1>Order Management</h1>
        <p>View customer orders and manage fulfilment.</p>
    </div>

    <p>
        <a href="/backend">← Back to Backend</a>
    </p>

    <div class="order-summary-grid">
        <div class="order-summary-card">
            <span>Total Orders</span>
            <strong><%= summary.total_orders %></strong>
        </div>

        <div class="order-summary-card">
            <span>Pending Orders</span>
            <strong><%= summary.pending_orders %></strong>
        </div>

        <div class="order-summary-card">
            <span>Non-cancelled Order Value</span>
            <strong>
                S$<%= Number(summary.active_order_value).toFixed(2) %>
            </strong>
        </div>
    </div>

    <!-- GET form: filters records without changing the DB. -->
    <form method="GET"
          action="/manage/orders"
          class="order-search-form">

        <div>
            <label for="search">Search orders</label>
            <input id="search"
                   name="search"
                   value="<%= search %>"
                   placeholder="Order number, name or email">
        </div>

        <div>
            <label for="status">Order status</label>
            <select id="status" name="status">
                <option value="">All statuses</option>

                <% statuses.forEach(function(item) { %>
                    <option value="<%= item %>"
                        <%= status === item ? 'selected' : '' %>>
                        <%= item %>
                    </option>
                <% }); %>
            </select>
        </div>

        <button type="submit" class="management-button">
            Search
        </button>

        <a href="/manage/orders">Clear</a>
    </form>

    <div class="order-table-scroll">
        <table class="order-management-table">
            <thead>
                <tr>
                    <th>Order</th>
                    <th>Customer</th>
                    <th>Fulfilment Date</th>
                    <th>Fulfilment</th>
                    <th>Items</th>
                    <th>Total</th>
                    <th>Order Status</th>
                    <th>Payment</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                <% if (!orders.length) { %>
                    <tr>
                        <td colspan="9">
                            No matching orders found.
                        </td>
                    </tr>
                <% } %>

                <% orders.forEach(function(order) { %>
                    <tr>
                        <td>#<%= order.order_id %></td>

                        <td>
                            <strong><%= order.full_name %></strong>
                            <small><%= order.email %></small>
                        </td>

                        <td><%= order.collection_date || 'Not set' %></td>

                        <td>
                            <%= order.fulfilment_method === 'Delivery'
                                ? 'Home Delivery'
                                : 'Self Collection' %>
                        </td>

                        <td><%= order.total_quantity %></td>

                        <td>
                            S$<%= Number(order.total_amount).toFixed(2) %>
                        </td>

                        <td><%= order.order_status %></td>

                        <td><%= order.payment_status %></td>

                        <td>
                            <a class="cf-order-view-button" href="/manage/orders/<%= order.order_id %>">
                                View / Edit
                            </a>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</section>
